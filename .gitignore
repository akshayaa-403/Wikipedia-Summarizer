# Browser tests. package.json IS committed -- it pins playwright, and without it
# `node tests/e2e/browser_check.mjs` is unrunnable from a fresh clone.
node_modules/
tests/screenshots/

# Benchmark run logs. The results themselves (docs/data/) ARE committed --
# the published site reads them directly.
bench.log
*.log

